{
  "openapi": "3.0.0",
  "info": {
    "title": "Deacons School API",
    "version": "1.0.0",
    "description": "API Documentation for Deacons School Management System"
  },

  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Development Server"
    },
    {
      "url": "https://your-backend.vercel.app",
      "description": "Production Server"
    }
  ],

  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Enter your JWT token"
      }
    },

    "schemas": {
      "LoginRequest": {
        "type": "object",
        "required": ["email", "password"],
        "properties": {
          "email": {
            "type": "string",
            "example": "admin@gmail.com"
          },
          "password": {
            "type": "string",
            "example": "123456"
          }
        }
      },

      "LoginResponse": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "example": "eyJhbGciOiJIUzI1NiIs..."
          },
          "message": {
            "type": "string",
            "example": "Login successful"
          }
        }
      }
    }
  },

  "paths": {
    "/test": {
      "get": {
        "summary": "Test Endpoint",
        "description": "Test if the server is running",
        "tags": ["Test"],
        "security": [],

        "responses": {
          "200": {
            "description": "Test successful"
          }
        }
      }
    }
  }
}
