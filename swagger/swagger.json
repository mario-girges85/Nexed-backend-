{
  "openapi": "3.0.3",
  "info": {
    "title": "Nexed API",
    "version": "1.0.0",
    "description": "API documentation for the Nexed backend. The route paths below are mounted directly by the Express application."
  },
  "servers": [
    {
      "production": "https://nexed-backend-six.vercel.app",
      "description": "production URL"
    },
    {
      "local": "https://locallhost:3000",
      "description": "Local development (replace the port if PORT is configured differently)"
    }
  ],
  "tags": [
    { "name": "Health", "description": "Service health check" },
    { "name": "Users", "description": "User registration and lookup" },
    { "name": "Authentication", "description": "Login and token refresh" },
    {
      "name": "Initialization",
      "description": "Bulk user templates and imports"
    }
  ],
  "paths": {
    "/test": {
      "get": {
        "tags": ["Health"],
        "summary": "Check that the server is running",
        "responses": {
          "200": {
            "description": "The server is running",
            "content": {
              "text/html": {
                "schema": { "type": "string", "example": "server is running" }
              }
            }
          }
        }
      }
    },
    "/init/bulkusersdownload": {
      "get": {
        "tags": ["Initialization"],
        "summary": "Download the bulk user upload template",
        "responses": {
          "200": {
            "description": "Excel template downloaded successfully",
            "headers": {
              "Content-Disposition": {
                "description": "Attachment filename for the downloaded template",
                "schema": {
                  "type": "string",
                  "example": "attachment; filename=users_template.xlsx"
                }
              }
            },
            "content": {
              "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet": {
                "schema": { "type": "string", "format": "binary" }
              }
            }
          },
          "404": {
            "description": "The template file was not found",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MessageResponse" }
              }
            }
          },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      }
    },
    "/init/bulkusersupload": {
      "post": {
        "tags": ["Initialization"],
        "summary": "Import users from an Excel template",
        "description": "Upload the XLSX file downloaded from /init/bulkusersdownload. The report identifies every successfully created user and every invalid row by worksheet name and Excel row number.",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": ["bulk_upload_template"],
                "properties": {
                  "bulk_upload_template": {
                    "type": "string",
                    "format": "binary",
                    "description": "XLSX file that follows the bulk user template."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The upload was processed; inspect the report for per-row results",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BulkUserUploadReport"
                }
              }
            }
          },
          "400": {
            "description": "No file was uploaded or the uploaded file could not be read",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MessageResponse" }
              }
            }
          }
        }
      }
    },
    "/user/signup": {
      "post": {
        "tags": ["Users"],
        "summary": "Register a user",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/SignupRequest" },
              "example": {
                "name": "Alex Doe",
                "email": "alex@example.com",
                "password": "example-password",
                "national_id": "12345678901234",
                "phonenumber": "01234567890",
                "birth_day": 15,
                "birth_month": 8,
                "birth_year": 2002,
                "address": "Cairo",
                "gender": "male",
                "profil_image": "https://example.com/profiles/alex.jpg",
                "role": "student"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "User registered successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserMutationResponse"
                }
              }
            }
          },
          "400": {
            "description": "Required fields are missing, invalid, or the email is already registered",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MessageResponse" },
                "examples": {
                  "missingFields": {
                    "value": { "message": "All fields are required" }
                  },
                  "duplicateEmail": {
                    "value": { "message": "User already exists" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/user/all-users": {
      "get": {
        "tags": ["Users"],
        "summary": "Fetch all users",
        "description": "Returns every user record. The current implementation serializes all model fields, including the stored password hash.",
        "responses": {
          "200": {
            "description": "Users fetched successfully",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/UsersResponse" }
              }
            }
          }
        }
      }
    },
    "/user/login": {
      "post": {
        "tags": ["Authentication"],
        "summary": "Log in and receive an access token",
        "description": "Returns a short-lived access token in the response body and sets a 30-day httpOnly refresh_token cookie.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/LoginRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login successful; refresh token is set as a cookie",
            "headers": {
              "Set-Cookie": {
                "description": "httpOnly refresh_token cookie",
                "schema": { "type": "string" }
              }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/TokenResponse" }
              }
            }
          },
          "400": {
            "description": "Missing fields or invalid credentials",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MessageResponse" },
                "examples": {
                  "missingFields": {
                    "value": { "message": "All fields are required" }
                  },
                  "invalidCredentials": {
                    "value": { "message": "invalid email or password" }
                  }
                }
              }
            }
          },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      }
    },
    "/user/refresh": {
      "post": {
        "tags": ["Authentication"],
        "summary": "Refresh the access token",
        "description": "Reads the refresh_token cookie and returns a new access token. The refresh cookie is not rotated.",
        "security": [{ "RefreshCookie": [] }],
        "responses": {
          "200": {
            "description": "A new access token was issued",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/TokenResponse" }
              }
            }
          },
          "401": {
            "description": "Refresh cookie is missing, invalid, expired, or refers to a missing user",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MessageResponse" },
                "examples": {
                  "missing": {
                    "value": { "message": "Refresh token is required" }
                  },
                  "invalid": {
                    "value": { "message": "Invalid or expired refresh token" }
                  }
                }
              }
            }
          },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      }
    },
    "/user/me": {
      "get": {
        "tags": ["Users"],
        "summary": "Get the authenticated user",
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": {
            "description": "User fetched successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserMutationResponse"
                }
              }
            }
          },
          "401": {
            "description": "Access token is missing, invalid, or expired",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MessageResponse" },
                "examples": {
                  "missing": {
                    "value": { "message": "Access token is required" }
                  },
                  "invalid": {
                    "value": { "message": "Invalid or expired access token" }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Authenticated user no longer exists",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MessageResponse" }
              }
            }
          },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Supply the access token returned by /user/login or /user/refresh."
      },
      "RefreshCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "refresh_token",
        "description": "Set by /user/login as an httpOnly cookie."
      }
    },
    "schemas": {
      "SignupRequest": {
        "type": "object",
        "required": [
          "name",
          "email",
          "password",
          "national_id",
          "phonenumber",
          "role"
        ],
        "properties": {
          "name": { "type": "string", "example": "Alex Doe" },
          "email": {
            "type": "string",
            "format": "email",
            "example": "alex@example.com"
          },
          "password": {
            "type": "string",
            "format": "password",
            "minLength": 8,
            "example": "example-password"
          },
          "national_id": {
            "type": "string",
            "pattern": "^\\d{14}$",
            "example": "12345678901234"
          },
          "phonenumber": {
            "type": "string",
            "pattern": "^01\\d{9}$",
            "description": "An 11-digit number beginning with 01. A valid 10-digit number beginning with 1 is normalized with a leading zero.",
            "example": "01234567890"
          },
          "birth_day": {
            "type": "integer",
            "minimum": 1,
            "maximum": 31,
            "example": 15
          },
          "birth_month": {
            "type": "integer",
            "minimum": 1,
            "maximum": 12,
            "example": 8
          },
          "birth_year": { "type": "integer", "example": 2002 },
          "address": { "type": "string", "example": "Cairo" },
          "gender": { "type": "string", "example": "male" },
          "profil_image": {
            "type": "string",
            "format": "uri",
            "nullable": true,
            "example": "https://example.com/profiles/alex.jpg"
          },
          "role": { "$ref": "#/components/schemas/UserRole" }
        }
      },
      "LoginRequest": {
        "type": "object",
        "required": ["email", "password"],
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "example": "alex@example.com"
          },
          "password": {
            "type": "string",
            "format": "password",
            "example": "example-password"
          }
        }
      },
      "UserRole": {
        "type": "string",
        "enum": ["admin", "staff", "employee", "student"]
      },
      "User": {
        "type": "object",
        "required": ["id", "name", "email", "role"],
        "properties": {
          "id": { "type": "integer", "example": 1 },
          "name": { "type": "string", "example": "Alex Doe" },
          "email": {
            "type": "string",
            "format": "email",
            "example": "alex@example.com"
          },
          "national_id": {
            "type": "string",
            "pattern": "^\\d{14}$",
            "example": "12345678901234"
          },
          "phonenumber": {
            "type": "string",
            "pattern": "^01\\d{9}$",
            "example": "01234567890"
          },
          "birth_day": {
            "type": "integer",
            "minimum": 1,
            "maximum": 31,
            "nullable": true,
            "example": 15
          },
          "birth_month": {
            "type": "integer",
            "minimum": 1,
            "maximum": 12,
            "nullable": true,
            "example": 8
          },
          "birth_year": { "type": "integer", "nullable": true, "example": 2002 },
          "address": { "type": "string", "nullable": true, "example": "Cairo" },
          "gender": { "type": "string", "nullable": true, "example": "male" },
          "profil_image": {
            "type": "string",
            "format": "uri",
            "nullable": true,
            "example": "https://example.com/profiles/alex.jpg"
          },
          "role": { "$ref": "#/components/schemas/UserRole" }
        }
      },
      "UserWithPasswordHash": {
        "allOf": [
          { "$ref": "#/components/schemas/User" },
          {
            "type": "object",
            "required": ["password"],
            "properties": {
              "password": {
                "type": "string",
                "description": "Stored bcrypt password hash returned by the current all-users implementation."
              }
            }
          }
        ]
      },
      "MessageResponse": {
        "type": "object",
        "required": ["message"],
        "properties": { "message": { "type": "string" } }
      },
      "BulkUserRow": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "example": "Alex Doe" },
          "email": {
            "type": "string",
            "format": "email",
            "example": "alex@example.com"
          },
          "national_id": {
            "type": "string",
            "pattern": "^\\d{14}$",
            "example": "12345678901234"
          },
          "phonenumber": {
            "type": "string",
            "pattern": "^01\\d{9}$",
            "example": "01234567890"
          },
          "birth_day": {
            "type": "integer",
            "minimum": 1,
            "maximum": 31,
            "example": 15
          },
          "birth_month": {
            "type": "integer",
            "minimum": 1,
            "maximum": 12,
            "example": 8
          },
          "birth_year": { "type": "integer", "example": 2002 },
          "address": { "type": "string", "example": "Cairo" },
          "gender": { "type": "string", "example": "male" },
          "role": { "$ref": "#/components/schemas/UserRole" },
          "profil_image": { "type": "string", "nullable": true }
        }
      },
      "BulkUserImportSuccess": {
        "type": "object",
        "required": ["sheet", "row", "user"],
        "properties": {
          "sheet": { "type": "string", "example": "users" },
          "row": { "type": "integer", "example": 3 },
          "user": {
            "allOf": [
              { "$ref": "#/components/schemas/BulkUserRow" },
              {
                "type": "object",
                "properties": { "id": { "type": "integer", "example": 1 } }
              }
            ]
          }
        }
      },
      "BulkUserImportProblem": {
        "type": "object",
        "required": ["sheet", "row", "user", "message"],
        "properties": {
          "sheet": { "type": "string", "example": "users" },
          "row": { "type": "integer", "example": 4 },
          "user": { "$ref": "#/components/schemas/BulkUserRow" },
          "message": {
            "type": "string",
            "example": "Phone number must be 11 digits and start with 01"
          }
        }
      },
      "BulkUserUploadReport": {
        "type": "object",
        "required": ["summary", "successfullyAddedUsers", "problematicRows"],
        "properties": {
          "summary": {
            "type": "object",
            "required": [
              "sheetsProcessed",
              "totalRows",
              "successfullyAdded",
              "failedRows"
            ],
            "properties": {
              "sheetsProcessed": { "type": "integer", "example": 1 },
              "totalRows": { "type": "integer", "example": 2 },
              "successfullyAdded": { "type": "integer", "example": 1 },
              "failedRows": { "type": "integer", "example": 1 }
            }
          },
          "successfullyAddedUsers": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/BulkUserImportSuccess" }
          },
          "problematicRows": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/BulkUserImportProblem" }
          }
        }
      },
      "UserMutationResponse": {
        "type": "object",
        "required": ["message", "userData"],
        "properties": {
          "message": { "type": "string" },
          "userData": { "$ref": "#/components/schemas/User" }
        }
      },
      "UsersResponse": {
        "type": "object",
        "required": ["message", "userData"],
        "properties": {
          "message": { "type": "string" },
          "userData": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/UserWithPasswordHash" }
          }
        }
      },
      "TokenResponse": {
        "type": "object",
        "required": ["message", "access_token"],
        "properties": {
          "message": { "type": "string", "example": "Login successful" },
          "access_token": {
            "type": "string",
            "description": "JWT access token; expires after 15 minutes."
          }
        }
      }
    },
    "responses": {
      "ServerError": {
        "description": "Internal server error or authentication is not configured",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/MessageResponse" },
            "examples": {
              "internal": { "value": { "message": "Internal server error" } },
              "configuration": {
                "value": { "message": "Authentication is not configured" }
              }
            }
          }
        }
      }
    }
  }
}
